# This is an unauthenticated public demo; do not use sensitive data.
# Optional PostgreSQL URL; when set, it takes precedence over STATE_FILE.
DATABASE_URL=
# Optional path to a persistent disk; default ./state.json.
STATE_FILE=
# Optional for live AI and batch triage. Use one provider; free-tier limits may apply.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Or set AI_PROVIDER=openai and use the following:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
